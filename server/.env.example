# Environment Variables Example for Dashly Backend

PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_app?schema=public"
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL="http://localhost:3000"

# Set to false to disable dev OTP auto-fill in development or when ready for production
ENABLE_DEV_OTP=true

# Initial admin account seed credentials
ADMIN_DEFAULT_EMAIL=admin@plukit.in
ADMIN_INITIAL_PASSWORD=change_this_to_a_secure_password

# SMS Gateway Provider (F10)
# Chosen provider: MSG91 (DLT approved in India). Use test credentials for staging.
SMS_PROVIDER=msg91
SMS_AUTH_KEY=test_msg91_auth_key_dummy
SMS_TEMPLATE_ID=1007123456789012345
