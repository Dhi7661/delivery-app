# Environment Variables Example for Dashly Backend

PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_app?schema=public"
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL="http://localhost:3000"

# Set to false to disable dev OTP auto-fill in development or when ready for production
ENABLE_DEV_OTP=true

# Temporary admin password for F07 CSV upload
ADMIN_PASSWORD=your_admin_password_here
