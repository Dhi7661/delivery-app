generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SHOP
  ADMIN
  RIDER
}

enum OrderStatus {
  PLACED
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  SENT_TO_SHOP
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  CANCELLED
  RETURNED
  CLOSED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PENDING_COLLECTION
  SUCCESS
  FAILED
  REFUNDED
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LedgerEntryType {
  SALE
  RETURN_DEDUCTION
  ADJUSTMENT
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutMode {
  UPI
  CASH
  BANK
}

model User {
  id         String    @id @default(uuid())
  name       String?
  phone      String    @unique
  email      String?
  role       Role      @default(CUSTOMER)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  addresses  Address[]
  orders     Order[]
  tickets    SupportTicket[]
  sessions       Session[]
  rider_sessions RiderSession[]
  cash_handovers CashHandover[]
  cart           Cart?

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model OtpVerification {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp_hash   String
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("otp_verifications")
}

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  name              String?
  phone             String?
  two_factor_secret String?
  password_hash     String
  is_active     Boolean        @default(true)
  last_login_at DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  sessions      AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id            String    @id @default(uuid())
  admin_user_id String
  token          String    @unique
  last_active_at DateTime  @default(now())
  expires_at     DateTime
  created_at    DateTime  @default(now())

  admin_user    AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)

  @@index([admin_user_id])
  @@map("admin_sessions")
}

model Address {
  id         String   @id @default(uuid())
  user_id    String
  line1      String
  landmark   String?
  pincode    String
  lat        Float?
  lng        Float?
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("addresses")
}

model Shop {
  id              String          @id @default(uuid())
  name            String          @unique
  owner_name      String
  phone           String
  gstin           String?
  fssai_no        String?
  upi_id          String?
  address         String?         @default("Pune, Maharashtra")
  payout_cycle    String          @default("15_DAYS")
  commission_rate Float           @default(0.10)
  status          ShopStatus      @default(ACTIVE)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  bank_ref        ShopBankRef?
  products        Product[]
  ledger_entries  ShopLedger[]
  payouts         Payout[]
  order_items     OrderItem[]
  issues          OperationalIssue[]

  @@map("shops")
}

model ShopBankRef {
  id           String    @id @default(uuid())
  shop_id      String    @unique
  provider_ref String
  last4        String
  bank_name    String?
  ifsc_code    String?
  account_name String?
  verified_at  DateTime?

  shop         Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@map("shop_bank_refs")
}

model Category {
  id         String     @id @default(uuid())
  name       String     @unique
  parent_id  String?
  sort_order Int        @default(0)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())

  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]

  @@map("categories")
}

model Product {
  id                 String         @id @default(uuid())
  shop_id            String
  category_id        String
  name               String
  brand              String?
  unit_size          String
  hsn_code           String?
  gst_rate           Float          @default(0.0)
  mrp_paise          Int
  shop_price_paise   Int
  selling_price_paise Int
  is_available       Boolean        @default(true)
  is_active          Boolean        @default(true)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  shop               Shop           @relation(fields: [shop_id], references: [id])
  category           Category       @relation(fields: [category_id], references: [id])
  price_history      PriceHistory[]
  order_items        OrderItem[]
  cart_items         CartItem[]

  @@unique([shop_id, name, unit_size])
  @@index([shop_id, is_available])
  @@index([category_id, is_available])
  @@map("products")
}

model PriceHistory {
  id                  String   @id @default(uuid())
  product_id          String
  mrp_paise           Int
  shop_price_paise    Int
  selling_price_paise Int
  effective_from      DateTime @default(now())

  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model ServiceablePincode {
  pincode              String   @id
  is_active            Boolean  @default(true)
  delivery_fee_paise   Int      @default(3000)
  free_threshold_paise Int      @default(15000)

  @@map("serviceable_pincodes")
}

model Order {
  id                  String        @id @default(uuid())
  order_no            String        @unique
  user_id             String?
  guest_name          String?
  guest_phone         String?
  address             Json
  status              OrderStatus   @default(PLACED)
  subtotal_paise      Int
  delivery_fee_paise  Int           @default(0)
  total_paise         Int
  payment_method      PaymentMethod @default(COD)
  payment_status      PaymentStatus @default(PENDING)
  idempotency_key               String        @unique
  confirmed_with_customer_at    DateTime?
  customer_confirmation_method  String?
  customer_accepted_changes_at  DateTime?
  shop_packing_note             String?
  created_at                    DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  user                User?         @relation(fields: [user_id], references: [id])
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  delivery            Delivery?
  invoice             Invoice?
  support_tickets     SupportTicket[]
  notifications       OrderNotification[]
  issues              OperationalIssue[]

  @@index([user_id, created_at(sort: Desc)])
  @@index([status, created_at])
  @@map("orders")
}

model OrderItem {
  id                  String       @id @default(uuid())
  order_id            String
  product_id          String
  shop_id             String
  qty                 Int
  mrp_paise           Int
  shop_price_paise    Int
  selling_price_paise Int
  line_total_paise    Int
  is_available        Boolean      @default(true)
  unavailable_noted_at DateTime?

  order               Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product             Product      @relation(fields: [product_id], references: [id])
  shop                Shop         @relation(fields: [shop_id], references: [id])
  returns             Return[]
  ledger_entries      ShopLedger[]

  @@index([order_id])
  @@map("order_items")
}

model Payment {
  id                 String        @id @default(uuid())
  order_id           String
  gateway            String
  gateway_order_id   String?
  gateway_payment_id String?       @unique
  amount_paise       Int
  status             PaymentStatus @default(PENDING)
  created_at         DateTime      @default(now())

  order              Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("payments")
}

model Refund {
  id                String   @id @default(uuid())
  order_id          String
  amount_paise      Int
  reason            String
  status            String   @default("INITIATED")
  gateway_refund_id String?
  created_at        DateTime @default(now())

  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("refunds")
}

model Delivery {
  id                  String   @id @default(uuid())
  order_id            String   @unique
  assigned_to         String?
  status              String   @default("PENDING")
  cod_collected_paise Int      @default(0)
  delivered_at        DateTime?
  failure_reason      String?
  proof_url           String?
  cash_note           String?

  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

model Return {
  id              String    @id @default(uuid())
  order_item_id   String
  qty             Int
  reason_code     String
  shop_cost_paise Int
  status          String    @default("PENDING")
  created_at      DateTime  @default(now())

  order_item      OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@map("returns")
}

model ShopLedger {
  id            String          @id @default(uuid())
  shop_id       String
  order_item_id String?
  payout_id     String?
  amount_paise  Int
  entry_type    LedgerEntryType
  notes         String?
  created_at    DateTime        @default(now())

  shop          Shop            @relation(fields: [shop_id], references: [id])
  order_item    OrderItem?      @relation(fields: [order_item_id], references: [id])
  payout        Payout?         @relation(fields: [payout_id], references: [id])

  @@index([shop_id, created_at])
  @@index([payout_id])
  @@map("shop_ledger")
}

model Payout {
  id                String       @id @default(uuid())
  shop_id           String
  period_start      DateTime
  period_end        DateTime
  gross_sales_paise Int          @default(0)
  deductions_paise  Int          @default(0)
  amount_paise      Int
  status            String       @default("SCHEDULED")
  paid_at           DateTime?
  payment_mode      PayoutMode   @default(BANK)
  bank_reference    String?
  upi_ref           String?
  cash_note         String?
  pdf_url           String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  shop              Shop         @relation(fields: [shop_id], references: [id])
  ledger_entries    ShopLedger[]

  @@index([shop_id, period_start, period_end])
  @@map("payouts")
}

model Invoice {
  id                  String       @id @default(uuid())
  order_id            String       @unique
  invoice_no          String       @unique
  invoice_date        DateTime     @default(now())
  seller_name         String       @default("PlukIt Quick Commerce Private Limited")
  seller_gstin        String       @default("27AABCP1234F1Z6")
  seller_fssai        String?      @default("11526000000000")
  buyer_name          String       @default("")
  buyer_phone         String?
  buyer_address       Json         @default("{}")
  delivery_fee_paise  Int          @default(0)
  taxable_amount_paise Int
  gst_amount_paise    Int
  total_paise         Int          @default(0)
  cgst_paise          Int          @default(0)
  sgst_paise          Int          @default(0)
  igst_paise          Int          @default(0)
  items_snapshot      Json         @default("[]")
  pdf_url             String?

  order               Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  credit_notes        CreditNote[]

  @@map("invoices")
}

model CreditNote {
  id                   String   @id @default(uuid())
  invoice_id           String
  credit_note_no       String   @unique
  reason               String
  taxable_amount_paise Int
  gst_amount_paise     Int
  total_paise          Int
  pdf_url              String?
  created_at           DateTime @default(now())

  invoice              Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("credit_notes")
}

model SupportTicket {
  id         String   @id @default(uuid())
  order_id   String?
  user_id    String
  issue_type String
  message    String
  status     String   @default("OPEN")
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  order      Order?   @relation(fields: [order_id], references: [id])

  @@map("support_tickets")
}

model AuditLog {
  id         String   @id @default(uuid())
  actor_id   String
  action     String
  entity     String
  entity_id  String
  old_value  Json?
  new_value  Json?
  created_at DateTime @default(now())

  @@index([entity, entity_id])
  @@index([actor_id])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value_paise Int
  is_dummy    Boolean  @default(true)
  updated_at  DateTime @updatedAt

  @@map("settings")
}

model Cart {
  id         String     @id @default(uuid())
  token      String     @unique
  user_id    String?    @unique
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  items      CartItem[]

  user       User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cart_id    String
  product_id String
  qty        Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cart       Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
  @@map("cart_items")
}

model OrderNotification {
  id             String              @id @default(uuid())
  order_id       String
  order_status   OrderStatus
  recipient_type String              // "CUSTOMER" or "SHOP"
  recipient      String              // Normalized phone or email
  channel        NotificationChannel @default(SMS)
  message        String
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  last_error     String?
  metadata       Json?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  order          Order               @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, order_status, recipient_type, recipient, channel])
  @@index([order_id])
  @@index([status, created_at])
  @@map("order_notifications")
}



model ProcessedEvent {
  id           String   @id @default(uuid())
  event_id     String   @unique
  event_type   String
  payload      Json?
  processed_at DateTime @default(now())

  @@index([event_id])
  @@map("processed_events")
}

// -----------------------------------------------------------------------------
// F22: Soft Launch Operations Models
// -----------------------------------------------------------------------------

enum IssueCategory {
  LATE_DELIVERY
  WRONG_ITEM
  REFUSED_ORDER
  DAMAGED_ITEM
  REFUND_DISPUTE
  OTHER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model OperationalIssue {
  id               String        @id @default(uuid())
  order_id         String?
  order_no         String?
  shop_id          String?
  category         IssueCategory @default(OTHER)
  severity         IssueSeverity @default(MEDIUM)
  status           IssueStatus   @default(OPEN)
  description      String
  root_cause       String?
  resolution_notes String?
  reported_by      String        @default("ADMIN") // e.g. "CUSTOMER", "RIDER", "SHOP", "ADMIN"
  resolved_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  order            Order?        @relation(fields: [order_id], references: [id], onDelete: SetNull)
  shop             Shop?         @relation(fields: [shop_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([category])
  @@index([shop_id])
  @@map("operational_issues")
}

model CashReconciliation {
  id                    String   @id @default(uuid())
  date                  String   // YYYY-MM-DD
  rider_name            String   // Rider / Delivery champion name or ID
  orders_count          Int      @default(0)
  expected_cash_paise   Int      @default(0)
  collected_cash_paise  Int      @default(0)
  variance_paise        Int      @default(0) // collected - expected (negative = shortage)
  status                String   @default("BALANCED") // "BALANCED", "DISCREPANCY", "RESOLVED"
  notes                 String?
  reconciled_by         String?  // Admin ID / email
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([date, rider_name])
  @@index([date])
  @@map("cash_reconciliations")
}


model RiderSession {
  id             String   @id @default(uuid())
  user_id        String
  token          String   @unique
  last_active_at DateTime @default(now())
  expires_at     DateTime
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("rider_sessions")
}

model CashHandover {
  id                   String    @id @default(uuid())
  rider_id             String
  handover_date        String
  expected_amount_paise Int      @default(0)
  actual_amount_paise   Int      @default(0)
  difference_note      String?
  rider_confirmed_at   DateTime?
  admin_confirmed_at   DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  rider                User      @relation(fields: [rider_id], references: [id], onDelete: Cascade)

  @@index([rider_id, handover_date])
  @@map("cash_handovers")
}
